; Dice & Dungeon — прототип механики
; Godot 4.3

config_version=5

[application]

config/name="Dice & Dungeon"
config/description="Роглайт-колодострой, где карты оплачиваются броском кубиков."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DB="*res://scripts/data/DB.gd"
Palette="*res://scripts/data/Palette.gd"
Icons="*res://scripts/data/Icons.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.086, 0.075, 0.106, 1)

[gui]

timers/tooltip_delay_sec=0.15

theme/default_font_multichannel_signed_distance_field=true
